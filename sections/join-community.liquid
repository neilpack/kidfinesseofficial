<style>
  /* Scoped styles to prevent global conflicts */
  .join-community-wrapper-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1400px;
    margin: {{ section.settings.margin_top }}px auto {{ section.settings.margin_bottom }}px auto;
    padding: 0 20px;
    text-align: center;
    overflow: hidden; /* Prevents horizontal scrollbar during slide-in animation */
  }

  .join-community-heading-{{ section.id }} {
    margin-bottom: 40px;
    font-size: 32px;
    text-transform: uppercase;
    font-family: var(--font-heading-family), sans-serif; 
  }

  /* Flex container for the three animated titles */
  .jc-animated-titles-{{ section.id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 40px;
    margin-top: 100px;
    margin-bottom: 100px;
    width: 100%;
  }

  /* Animated h3 Title Base Styles */
  .jc-animated-titles-{{ section.id }} h3 {
    color: #ffffff;
    margin: 0;
    font-size: 24px;
    font-family: var(--font-heading-family), sans-serif;
  }

  /* Animation Classes */
  .jc-hidden {
    opacity: 0;
    transition: all 1s ease-out;
    filter: blur(5px);
    transform: translateX(-100%);
  }

  .jc-show {
    opacity: 1;
    filter: blur(0);
    transform: translateX(0);
  }

  /* Sequential Delays */
  .jc-animated-titles-{{ section.id }} h3:nth-child(1) {
    transition-delay: 200ms;
  }
  .jc-animated-titles-{{ section.id }} h3:nth-child(2) {
    transition-delay: 400ms;
  }
  .jc-animated-titles-{{ section.id }} h3:nth-child(3) {
    transition-delay: 600ms;
  }

  /* Respect User Motion Preferences */
  @media (prefers-reduced-motion) {
    .jc-hidden {
      transition: none;
      opacity: 1;
      filter: blur(0);
      transform: translateX(0);
    }
  }

  /* Join Button Styles (Derived from custom-music.liquid) */
  .jc-button-{{ section.id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: transparent;
    color: #ffffff !important;
    border: 1px solid #ffffff;
    border-radius: 4px;
    text-decoration: none !important;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 14px;
    font-family: var(--font-heading-family) !important;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .jc-button-{{ section.id }}:hover {
    background-color: #ffffff;
    color: #000000 !important;
  }

  /* Mobile Stacking Rules */
  @media (max-width: 768px) {
    /* Hides the heading on mobile while keeping the section anchor link functional */
    .join-community-heading-{{ section.id }} {
      display: none;
    }

    .jc-animated-titles-{{ section.id }} {
      flex-direction: column;
      font-size: 18px;
      gap: 20px; /* Spacing between the stacked h3s on mobile */
      margin-top: 60px; /* Optional: shrink the huge margins slightly on mobile so it doesn't look empty */
      margin-bottom: 60px;
    }
  }
</style>

<div class="join-community-wrapper-{{ section.id }}" id="stayconnected">
  
  {% if section.settings.heading != blank %}
    <h1 class="join-community-heading-{{ section.id }}">{{ section.settings.heading }}</h1>
  {% endif %}

  <div class="jc-animated-titles-{{ section.id }}">
    {% if section.settings.title_1 != blank %}
      <h3 class="jc-hidden">{{ section.settings.title_1 }}</h3>
    {% endif %}
    {% if section.settings.title_2 != blank %}
      <h3 class="jc-hidden">{{ section.settings.title_2 }}</h3>
    {% endif %}
    {% if section.settings.title_3 != blank %}
      <h3 class="jc-hidden">{{ section.settings.title_3 }}</h3>
    {% endif %}
  </div>

  {% if section.settings.button_text != blank %}
    <a href="{{ section.settings.button_link | default: '#' }}" class="jc-button-{{ section.id }}">
      {{ section.settings.button_text }}
    </a>
  {% endif %}

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Intersection Observer to trigger the fade/slide in
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('jc-show');
        } else {
          // Removes the class when out of view so the animation repeats when scrolled to again
          entry.target.classList.remove('jc-show');
        }
      });
    });

    // Target the hidden elements only within this specific section to avoid global conflicts
    const hiddenElements = document.querySelectorAll('#shopify-section-{{ section.id }} .jc-hidden');
    hiddenElements.forEach((el) => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Join Community",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STAY CONNECTED"
    },
    {
      "type": "header",
      "content": "Animated Subtitles"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Left Title",
      "default": "EXCLUSIVE CONTENT"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Middle Title",
      "default": "DISCOUNTS"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Right Title",
      "default": "ALL IN ONE PLACE"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "JOIN THE COMMUNITY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Join Community",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}