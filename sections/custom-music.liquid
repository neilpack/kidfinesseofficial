<style>
  /* Force black text and white background specifically for the h1 in this section */
  #shopify-section-{{ section.id }} h1 {
    font-family: var(--font-heading-family) !important;
    text-decoration: none !important;
    margin: 0;
  }

  /* Force white text for the rest of the elements in this section */
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} p,
  #shopify-section-{{ section.id }} a {
    color: #ffffff !important;
    font-family: var(--font-heading-family) !important;
  }
</style>

<div class="content-section" id="music">
    <div>
        <h1>{{ section.settings.section_title | default: 'MUSIC' }}</h1>
    </div>

    <div style="width: 100%; max-width: 800px; display: flex; flex-direction: column; align-items: center; gap: 24px; margin: 0 auto; padding-bottom: 20px;">
        
        <div style="width: 100%;">
            {% if section.settings.spotify_embed_top != blank %}
                {{ section.settings.spotify_embed_top }}
            {% else %}
                <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/playlist/37i9dQZF1DZ06evO1V6H8D?utm_source=generator" width="100%" height="400" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
            {% endif %}
        </div>

        <div style="width: 100%;">
            {% if section.settings.spotify_embed != blank %}
                {{ section.settings.spotify_embed }}
            {% else %}
                <div class="placeholder-box" style="width: 100%; height: 352px; background-color: #111; color: #ffffff !important; display: flex; justify-content: center; align-items: center; border-radius: 12px;">SPOTIFY WEB PLAYER</div>
            {% endif %}
        </div>
        
    </div>
</div>

{% schema %}
{
  "name": "Custom Music",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "MUSIC"
    },
    {
      "type": "textarea",
      "id": "spotify_embed_top",
      "label": "Top Spotify Embed Code (iframe)",
      "info": "Paste the iframe code directly from Spotify here for the top playlist."
    },
    {
      "type": "textarea",
      "id": "spotify_embed",
      "label": "Bottom Spotify Embed Code (iframe)",
      "info": "Paste the iframe code directly from Spotify here for the bottom playlist."
    }
  ],
  "presets": [
    {
      "name": "Custom Music",
      "category": "Music"
    }
  ]
}
{% endschema %}